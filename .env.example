# Copy to .env.local for local dev. Set the same values in Vercel
# (Settings > Environment Variables) for Production AND Preview.
# Vercel and .env.local are separate stores: setting one does not set the other.

# Public URL of the site, no trailing slash. Used for canonical links, sitemap, share images.
NEXT_PUBLIC_SITE_URL=https://dadadaniels.vercel.app

# Contact form (Resend). Key with sending access only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=danielsatemail@gmail.com
# Until a domain is verified in Resend, only onboarding@resend.dev works,
# and it can only deliver to the Resend account owner's address.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Calendly event link, e.g. https://calendly.com/dadadaniels/30min
NEXT_PUBLIC_CALENDLY_URL=
